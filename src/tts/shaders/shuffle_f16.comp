#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// Wide Sub-Pixel-Shuffle f16: u[co,n] = C[co*r + (n+pad)%r, (n+pad)/r], C ist [Cout*r, Tconv].
layout(local_size_x = 256) in;
layout(std430, binding=0) readonly buffer P { uint Cout,outT,r,pad,Tconv; } p;
layout(std430, binding=1) readonly buffer Cbuf { float16_t cin[]; };
layout(std430, binding=2) writeonly buffer O { float16_t u[]; };
void main(){
  uint gid=gl_GlobalInvocationID.x;
  if(gid >= p.Cout*p.outT) return;
  uint co=gid/p.outT, n=gid%p.outT;
  uint m=n+p.pad; uint q=m/p.r, s=m%p.r;
  u[co*p.outT + n] = cin[(co*p.r + s)*p.Tconv + q];
}
