#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// MRF-Mittelung f16: o[c,t] = (a+b+c)/3. Bindings: 0=params 1=a 2=b 3=c 4=out
layout(local_size_x = 256) in;
layout(std430, binding=0) readonly buffer P { uint N; } p;
layout(std430, binding=1) readonly buffer A { float16_t a[]; };
layout(std430, binding=2) readonly buffer B { float16_t b[]; };
layout(std430, binding=3) readonly buffer C { float16_t c[]; };
layout(std430, binding=4) writeonly buffer O { float16_t o[]; };
void main(){
  uint i=gl_GlobalInvocationID.x; if(i>=p.N) return;
  o[i]=float16_t((float(a[i])+float(b[i])+float(c[i]))*(1.0/3.0));
}
