#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// ggml-barra v2: Qwen3-Glue auf der GPU, Multi-Layer-Variante von rope_qk.comp.
// Liest TPU-int8-QKV, per-Head-RMSNorm(q,k)+RoPE, schreibt q/k als f16. Gamma/Tabellen-Offsets kommen
// als Push-Konstanten (ein Aux-Puffer fuer alle Layer). Workgroup=(head-row 0..39, token), 16 Threads.
layout(local_size_x=16) in;
layout(std430,binding=0) readonly  buffer QKV { uint qkv[]; };       // int8 [S,6144]
layout(std430,binding=1) writeonly buffer QK  { float16_t qk[]; };   // q [S*4096] + k [S*1024]
layout(std430,binding=2) readonly  buffer AUX { float aux[]; };      // gq[NL][128], gk[NL][128], cos[S*64], sin[S*64]
layout(push_constant) uniform P { float isc; float izp; float eps; uint gqo; uint gko; uint tabo; } pc;
shared float red[16];
shared float srms;
void main(){
  uint hr=gl_WorkGroupID.x, t=gl_WorkGroupID.y, tid=gl_LocalInvocationID.x;
  bool isq = hr<32u;
  uint rowbase = t*6144u + (isq ? hr*128u : 4096u+(hr-32u)*128u);
  uint j = tid*4u;
  uint w0=qkv[(rowbase+j)>>2], w1=qkv[(rowbase+64u+j)>>2];
  float f0[4], f1[4]; float ss=0.0;
  for(int u=0;u<4;u++){
    f0[u]=(float(bitfieldExtract(int(w0),u*8,8))-pc.izp)*pc.isc;
    f1[u]=(float(bitfieldExtract(int(w1),u*8,8))-pc.izp)*pc.isc;
    ss+=f0[u]*f0[u]+f1[u]*f1[u];
  }
  red[tid]=ss; barrier();
  if(tid<8u) red[tid]+=red[tid+8u]; barrier();
  if(tid<4u) red[tid]+=red[tid+4u]; barrier();
  if(tid==0u) srms=inversesqrt((red[0]+red[1]+red[2]+red[3])/128.0+pc.eps); barrier();
  float rms=srms;
  uint gb = isq?pc.gqo:pc.gko;
  uint outbase = isq ? (t*4096u+hr*128u) : (2097152u + t*1024u + (hr-32u)*128u);
  for(int u=0;u<4;u++){
    float g0=f0[u]*rms*aux[gb+j+uint(u)];
    float g1=f1[u]*rms*aux[gb+64u+j+uint(u)];
    float c =aux[pc.tabo        +t*64u+j+uint(u)];
    float sn=aux[pc.tabo+32768u +t*64u+j+uint(u)];
    qk[outbase+j+uint(u)]      = float16_t(g0*c-g1*sn);
    qk[outbase+64u+j+uint(u)]  = float16_t(g1*c+g0*sn);
  }
}
