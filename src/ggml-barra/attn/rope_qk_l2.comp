#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// ggml-barra v2.1: RMSNorm+RoPE aus GETRENNTEN q/k-int8-Puffern (Split-Packages, zeilennormierter
// Eingang -> srow[t] fuer exakte Dequant vor der Norm). Workgroup=(head-row 0..39, token), 16 Threads.
layout(local_size_x=16) in;
layout(std430,binding=0) readonly  buffer QB  { uint qb[]; };        // q int8 [S,4096]
layout(std430,binding=1) readonly  buffer KB  { uint kb[]; };        // k int8 [S,1024]
layout(std430,binding=2) writeonly buffer QK  { float16_t qk[]; };   // q f16 [S*4096] + k f16 [S*1024]
layout(std430,binding=3) readonly  buffer AUX { float aux[]; };      // gq[NL][128], gk[NL][128], cos, sin
layout(std430,binding=4) readonly  buffer SR  { float srow[]; };     // Zeilenskala h [S]
layout(push_constant) uniform P { float qosc; float qozp; float kosc; float kozp; float eps; uint gqo; uint gko; uint tabo; } pc;
shared float red[16];
shared float srms;
void main(){
  uint hr=gl_WorkGroupID.x, t=gl_WorkGroupID.y, tid=gl_LocalInvocationID.x;
  bool isq = hr<32u;
  uint j = tid*4u;
  uint w0, w1; float osc, ozp;
  if(isq){ uint rb=t*4096u+hr*128u; w0=qb[(rb+j)>>2]; w1=qb[(rb+64u+j)>>2]; osc=pc.qosc; ozp=pc.qozp; }
  else   { uint rb=t*1024u+(hr-32u)*128u; w0=kb[(rb+j)>>2]; w1=kb[(rb+64u+j)>>2]; osc=pc.kosc; ozp=pc.kozp; }
  float sf = osc*srow[t];
  float f0[4], f1[4]; float ss=0.0;
  for(int u=0;u<4;u++){
    f0[u]=(float(bitfieldExtract(int(w0),u*8,8))-ozp)*sf;
    f1[u]=(float(bitfieldExtract(int(w1),u*8,8))-ozp)*sf;
    ss+=f0[u]*f0[u]+f1[u]*f1[u];
  }
  red[tid]=ss; barrier();
  if(tid<8u) red[tid]+=red[tid+8u]; barrier();
  if(tid<4u) red[tid]+=red[tid+4u]; barrier();
  if(tid==0u) srms=inversesqrt((red[0]+red[1]+red[2]+red[3])/128.0+pc.eps); barrier();
  float rms=srms;
  uint gb = isq?pc.gqo:pc.gko;
  uint outbase = isq ? (t*4096u+hr*128u) : (2097152u + t*1024u + (hr-32u)*128u);
  for(int u=0;u<4;u++){
    float g0=f0[u]*rms*aux[gb+j+uint(u)];
    float g1=f1[u]*rms*aux[gb+64u+j+uint(u)];
    float c =aux[pc.tabo        +t*64u+j+uint(u)];
    float sn=aux[pc.tabo+32768u +t*64u+j+uint(u)];
    qk[outbase+j+uint(u)]      = float16_t(g0*c-g1*sn);
    qk[outbase+64u+j+uint(u)]  = float16_t(g1*c+g0*sn);
  }
}
