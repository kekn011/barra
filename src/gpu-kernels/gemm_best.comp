#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require
#define TM 128
#define TN 128
#define TK 32
#define MM 8
#define MNV 2
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding=0) readonly  buffer A { float16_t a[]; };
layout(std430, binding=1) readonly  buffer B { float16_t b[]; };
layout(std430, binding=2) writeonly buffer C { float16_t c[]; };
layout(push_constant) uniform P { uint M; uint N; uint K; } p;
shared f16vec4 As[TM][TK/4];      // A vektorisiert ueber K
shared f16vec4 Bs[TK][TN/4];      // B vektorisiert ueber N
void main(){
  uint tx=gl_LocalInvocationID.x, ty=gl_LocalInvocationID.y;
  uint brow=gl_WorkGroupID.y*TM, bcol=gl_WorkGroupID.x*TN;
  uint tid=ty*16u+tx; const uint NT=256u;
  f16vec4 acc[MM][MNV];
  [[unroll]] for(int i=0;i<MM;i++)[[unroll]] for(int v=0;v<MNV;v++) acc[i][v]=f16vec4(0.0);
  for(uint k0=0u;k0<p.K;k0+=TK){
    // As: TM * TK/4 vec4 = 128*8 = 1024 vec4, 256 threads -> 4 each
    for(uint idx=tid; idx<TM*(TK/4); idx+=NT){ uint r=idx/(TK/4), cc=idx%(TK/4);
      uint base=(brow+r)*p.K + k0 + cc*4u;
      As[r][cc]=f16vec4(a[base],a[base+1u],a[base+2u],a[base+3u]); }
    for(uint idx=tid; idx<TK*(TN/4); idx+=NT){ uint r=idx/(TN/4), cc=idx%(TN/4);
      uint base=(k0+r)*p.N + bcol + cc*4u;
      Bs[r][cc]=f16vec4(b[base],b[base+1u],b[base+2u],b[base+3u]); }
    barrier();
    [[unroll]] for(uint k4=0u;k4<TK/4u;k4++){
      f16vec4 av[MM];
      [[unroll]] for(int i=0;i<MM;i++) av[i]=As[ty*MM+i][k4];
      uint kb=k4*4u, cb=tx*MNV;
      f16vec4 b0[MNV],b1[MNV],b2[MNV],b3[MNV];
      [[unroll]] for(int v=0;v<MNV;v++){ b0[v]=Bs[kb][cb+v]; b1[v]=Bs[kb+1u][cb+v]; b2[v]=Bs[kb+2u][cb+v]; b3[v]=Bs[kb+3u][cb+v]; }
      [[unroll]] for(int i=0;i<MM;i++)[[unroll]] for(int v=0;v<MNV;v++){
        acc[i][v]=fma(f16vec4(av[i].x), b0[v], acc[i][v]);
        acc[i][v]=fma(f16vec4(av[i].y), b1[v], acc[i][v]);
        acc[i][v]=fma(f16vec4(av[i].z), b2[v], acc[i][v]);
        acc[i][v]=fma(f16vec4(av[i].w), b3[v], acc[i][v]);
      }
    }
    barrier();
  }
  [[unroll]] for(int i=0;i<MM;i++){
    uint row=brow+ty*MM+i;
    [[unroll]] for(int v=0;v<MNV;v++){
      uint col=bcol+ (tx*MNV+v)*4u;
      if(row<p.M){   // 4-breiten Store an der N-Kante klemmen (kein OOB bei N nicht-Vielfachem von 4)
        if(col   <p.N) c[row*p.N+col   ]=acc[i][v].x;
        if(col+1u<p.N) c[row*p.N+col+1u]=acc[i][v].y;
        if(col+2u<p.N) c[row*p.N+col+2u]=acc[i][v].z;
        if(col+3u<p.N) c[row*p.N+col+3u]=acc[i][v].w; }
    }
  }
}
