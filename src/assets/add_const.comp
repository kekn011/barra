#version 450
/* In-Place-Integer-Kernel fuer den Cross-Chip-Beweis: addiert 1000 auf jedes
 * Element. EIN Storage-Buffer (binding 0), int32 — passt zu den DSP-Kerneln,
 * damit GPU und DSP dieselben Bytes im geteilten dmabuf bearbeiten. */
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { int x[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < x.length()) x[i] = x[i] + 1000;
}
