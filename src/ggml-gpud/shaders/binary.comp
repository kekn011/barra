#version 450
// ADD/MUL/SUB/DIV f32 mit ggml-Broadcast (src1-Index modulo) und beliebigen Strides (in Elementen).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly  buffer A { float a[]; };
layout(std430, binding = 1) readonly  buffer B { float b[]; };
layout(std430, binding = 2) writeonly buffer D { float d[]; };
layout(push_constant) uniform PC {
    uint ne0, ne1, ne2, ne3;        // dst-Dimensionen
    uint nb00, nb01, nb02, nb03;    // src0-Strides (Elemente)
    uint nb10, nb11, nb12, nb13;    // src1-Strides (Elemente)
    uint nb0, nb1, nb2, nb3;        // dst-Strides (Elemente)
    uint ne10, ne11, ne12, ne13;    // src1-Dimensionen (Broadcast)
    uint offa, offb, offd, op;      // Element-Offsets (Alignment-Rest), Op 0 add 1 mul 2 sub 3 div
    uint n;
} pc;
void main() {
    uint g = (gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x) * 256u + gl_LocalInvocationID.x; if (g >= pc.n) return;
    uint i0 = g % pc.ne0; uint t = g / pc.ne0; uint i1 = t % pc.ne1; t /= pc.ne1; uint i2 = t % pc.ne2; uint i3 = t / pc.ne2;
    float x = a[pc.offa + i0 * pc.nb00 + i1 * pc.nb01 + i2 * pc.nb02 + i3 * pc.nb03];
    float y = b[pc.offb + (i0 % pc.ne10) * pc.nb10 + (i1 % pc.ne11) * pc.nb11 + (i2 % pc.ne12) * pc.nb12 + (i3 % pc.ne13) * pc.nb13];
    float r = (pc.op == 0u) ? x + y : (pc.op == 1u) ? x * y : (pc.op == 2u) ? x - y : x / y;
    d[pc.offd + i0 * pc.nb0 + i1 * pc.nb1 + i2 * pc.nb2 + i3 * pc.nb3] = r;
}
