# Line endings are load-bearing here: everything that runs ON THE DEVICE
# (toybox sh, the container, the i18n loader) must stay LF — CRLF breaks it.
# Windows-side PowerShell stays CRLF (with UTF-8 BOM, required by PS 5.1).
* text=auto

*.sh          text eol=lf
*.properties  text eol=lf
*.c           text eol=lf
*.h           text eol=lf
*.hpp         text eol=lf
*.cpp         text eol=lf
*.py          text eol=lf
*.comp        text eol=lf
*.S           text eol=lf
*.patch       text eol=lf
gki_defconfig text eol=lf
*.md          text eol=lf
*.yml         text eol=lf

*.ps1         text eol=crlf
*.vbs         text eol=crlf

*.exe         binary
*.elf         binary
*.spv         binary
*.wav         binary
*.tgz         binary
*.ks          binary

# Geraete-Skripte OHNE Dateiendung: fallen sonst unter "* text=auto" -> bei core.autocrlf=true
# kommen sie auf Windows mit CRLF aus dem Clone, und per adb aufs Geraet geschoben scheitern
# sie am ^M ("bad interpreter"). Alle laufen in bionic-sh oder im Container -> LF erzwingen.
src/boot/barra-apply-rename   text eol=lf
src/boot/barra-config         text eol=lf
src/boot/barra-firstboot      text eol=lf
src/boot/barra-prepare-image  text eol=lf
src/img-kit/barra-img         text eol=lf
src/perf/barra-perf           text eol=lf
src/pyannote/barra-diarize    text eol=lf
src/sdk/barra-smi             text eol=lf
src/sdk/barrac                text eol=lf
